// Evidence: build/menu-map/{score,factory}-<code>.txt, complete native disassembly.
// Counter loads/stores never use the general settings width: format 0 is one
// halfword, 1 is two halfwords HIGH then LOW, 2 is one native RAM word.
// GD32 writers serialize bytes unchanged; N32 writers REV each native word.
// transaction is the original PUSH.W after scheduling/readiness prefixes. The
// executor reproduces ALL prefix readiness guards before committing RAM; native
// physical-key eligibility, sentinels, CRC, cache, erase/program and IRQ code run
// unchanged. Complete saved CRC records are read back before leaving the editor.
// Limits include native RAM normalization, not only storage/increment width:
// Score 3013/3014 Main passes settings+0x50 to 0x080083f8/0x08008400;
// STRHHI at 0x08008430/0x08008438 writes 9999 back through that pointer.
// Factory GD32 non-history 0x080050f4 instead loads and discards its pointer:
// 0x08005138 -> 0x080057ce clamps only r5 to 99999, with no RAM writeback.
// Its native split-counter increment still saturates at 999999.
struct PuffProfile {
    uint32_t transaction, writer, crc, flashBegin, flashEnd;
    uint32_t offset, format, limit, recordBytes, guardMask;
    uint32_t increment, display;
};
