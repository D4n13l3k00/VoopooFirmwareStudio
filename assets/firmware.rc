#include <winver.h>
#define STUDIO_STRINGIFY_INNER(value) #value
#define STUDIO_STRINGIFY(value) STUDIO_STRINGIFY_INNER(value)

VS_VERSION_INFO VERSIONINFO
 FILEVERSION STUDIO_VERSION_TUPLE
 PRODUCTVERSION STUDIO_VERSION_TUPLE
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription", "Voopoo Firmware Studio"
            VALUE "FileVersion", STUDIO_STRINGIFY(STUDIO_VERSION_TEXT) "\0"
            VALUE "InternalName", "VoopooFirmwareStudio"
            VALUE "LegalCopyright", "Copyright (c) 2026 Daniel"
            VALUE "OriginalFilename", "VoopooFirmwareStudio.exe"
            VALUE "ProductName", "Voopoo Firmware Studio"
            VALUE "ProductVersion", STUDIO_STRINGIFY(STUDIO_VERSION_TEXT) "\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END

